          "pluginVersion": "4.14.0",
          "queryType": "table",
          "rawSql": "SELECT\n  TraceId,\n  min(Timestamp) AS trace_start,\n  dateDiff('millisecond', min(Timestamp), max(Timestamp)) AS duration_ms,\n  any(ServiceName) AS service,\n  count() AS span_count\nFROM otel_traces\nWHERE $__timeFilter(Timestamp)\nGROUP BY TraceId\nORDER BY trace_start DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
